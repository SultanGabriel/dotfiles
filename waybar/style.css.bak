* {
    font-family: sans-serif;
    font-size: 13px;
}

window#waybar {
    background: rgba(20, 24, 32, 0.92);
    color: #ffffff;
}

#workspaces button {
    padding: 0 8px;
    background: transparent;
    color: #aaaaaa;
    border: none;
}

#workspaces button.active {
    color: #ffffff;
    background: rgba(255, 255, 255, 0.12);
}

#clock,
#network,
#pulseaudio,
#tray {
    padding: 0 10px;
}
